# Nebius Token Factory Configuration (Required for live NVIDIA Nemotron inference)
NEBIUS_API_KEY="your_nebius_token_factory_api_key"
NEBIUS_BASE_URL="https://api.studio.nebius.ai/v1/"

# Three-Tier NVIDIA Nemotron Model Routing IDs
NEBIUS_MODEL_NANO="nvidia/Llama-3_1-Nemotron-Nano-8B-v1"
NEBIUS_MODEL_SUPER="nvidia/Llama-3_3-Nemotron-Super-49B-v1"
NEBIUS_MODEL_ULTRA="nvidia/Llama-3_1-Nemotron-Ultra-253B-v1"

# External Job & Live Company Intelligence APIs (Optional - graceful fallback included)
ADZUNA_APP_ID="your_adzuna_app_id"
ADZUNA_API_KEY="your_adzuna_api_key"
TAVILY_API_KEY="your_tavily_api_key"

# Demo Protection & Rate Limiting
MAX_CALLS_PER_SESSION="40"
ENABLE_RESPONSE_CACHE="true"
